# Copia este archivo como .env y rellena tus claves.

# Obligatoria. Gratis (100 peticiones/día) en https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# Opcional, para validar horarios y marcadores con una segunda fuente.
# Gratis en https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# Zona horaria para decidir qué es "hoy".
APUESTAS_TZ=America/Mexico_City

# Ligas a analizar (ids de API-Football) EN ORDEN DE PRIORIDAD: con el límite de peticiones, las
# primeras se descargan antes. 2 Champions, 3 Europa League, 39 Premier, 140 LaLiga, 78 Bundesliga,
# 71 Brasileirão, 13 Libertadores, 848 Conference League, 11 Sudamericana, 16 Concacaf Champions Cup,
# 15 Mundial de Clubes, 531 Supercopa de Europa. (Otras: 135 Serie A, 61 Ligue 1, 262 Liga MX.)
APUESTAS_LIGAS=2,3,39,140,78,71,13,848,11,16,15,531
# Ligas que solo se analizan para tarjetas, al final de la cola (239 = Liga BetPlay, Colombia).
APUESTAS_LIGAS_SOLO_TARJETAS=239

# Límite de peticiones por ejecución (deja margen respecto al límite diario de tu plan).
APUESTAS_PRESUPUESTO=60
# Peticiones para los chequeos de alineación (2 por partido: alineaciones + cuotas del momento).
APUESTAS_PRESUPUESTO_CHEQUEO=30
APUESTAS_MAX_PARTIDOS=12
APUESTAS_HISTORIAL=6

# Filtros de selección.
APUESTAS_PROB_MIN=0.62
APUESTAS_VALOR_MIN=0.05
APUESTAS_CUOTA_MIN=1.25
# 0.2 según el backtest: el mercado predice mejor que el modelo, así que pesa más.
APUESTAS_PESO_MODELO=0.2
APUESTAS_PROB_MIN_COMBI=0.35
APUESTAS_MAX_SELECCIONES=4

# Modelo histórico (football-data.co.uk, sin clave). 0 = desactivado.
APUESTAS_HISTORICO=1
# Códigos de football-data.co.uk: E0 Premier, E1 Championship, SP1 LaLiga, I1 Serie A, D1 Bundesliga,
# F1 Ligue 1, N1 Eredivisie, P1 Portugal, MEX Liga MX, ARG Argentina, BRA Brasil (ver README).
APUESTAS_LIGAS_HISTORICO=E0,SP1,D1,BRA
APUESTAS_TEMPORADAS=5

# Combinada "lotería": cuota mínima total y máximo de selecciones (APUESTAS_CUOTA_LOTERIA=0 la desactiva).
APUESTAS_CUOTA_LOTERIA=100
APUESTAS_MAX_SELECCIONES_LOTERIA=12
# "Crea tu apuesta" (varias selecciones del mismo partido): cuota justa mínima (0 = desactivada).
APUESTAS_CUOTA_CREA=3
